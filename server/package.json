{
  "name": "ivac-control-center-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "purge:otps": "tsx src/purge-expired-otps.ts",
